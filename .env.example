# Decapod reads API keys from the environment and from .env files:
#   1. the instance's .env (created by `decapod init`)
#   2. the user-wide .env (`decapod doctor` prints its path, e.g. ~/.config/decapod/.env)
# Set one or more provider keys. With no [llm] config, Decapod uses the first one found,
# in this order: Anthropic, OpenAI, OpenRouter, DeepSeek, Gemini, Mistral, Groq, Together,
# xAI, Fireworks. Route individual tiers elsewhere in decapod.toml.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
FIREWORKS_API_KEY=

# Optional integrations
# BRAVE_API_KEY=
# GITHUB_TOKEN=
# DECAPOD_EMAIL_USERNAME=
# DECAPOD_EMAIL_PASSWORD=
